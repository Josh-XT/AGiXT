map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /web-config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /web-config.js =404;
  }

  location = /web-runtime.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /web-runtime.js =404;
  }

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /index.html =404;
  }

  location = /oauth-close.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /oauth-close.html =404;
  }

  location = /privacy {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/privacy.html =404;
  }

  location = /privacy/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/privacy.html =404;
  }

  location = /terms {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/terms.html =404;
  }

  location = /terms/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/terms.html =404;
  }

  location = /data-deletion {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/data-deletion.html =404;
  }

  location = /data-deletion/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /public/data-deletion.html =404;
  }

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  location /v1/ {
    proxy_pass ${AGIXT_API_UPSTREAM}/v1/;
  }

  location /outputs/ {
    proxy_pass ${AGIXT_API_UPSTREAM}/outputs/;
  }

  location /workspace/ {
    proxy_pass ${AGIXT_API_UPSTREAM}/workspace/;
  }

  location /user/close/ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /oauth-close.html =404;
  }

  # The Tauri/web shell is a single-page app with relative asset URLs so it
  # also works from the desktop bundle. When a hosted user refreshes on a deep
  # route such as /user/billing or /chat/{id}, browsers resolve those relative
  # assets under the route prefix. Try the path with the conv-id-shaped segment
  # kept (so /chat/vendor/monaco/vs/loader.js resolves to /vendor/...) before
  # falling back to stripping it (so /chat/{id}/styles.css resolves to /styles.css).
  location ~ ^/(user|chat|settings|machines|workspace|companies|teams|webhooks|developer|account|app|glasses)/([^/]+)/(.+\.(css|js|mjs|svg|png|jpg|jpeg|gif|webp|ico|wasm|map|json|woff|woff2|ttf|eot))$ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /$2/$3 /$3 =404;
  }

  location ~ ^/(user|chat|settings|machines|workspace|companies|teams|webhooks|developer|account|app|glasses)/(.+\.(css|js|mjs|svg|png|jpg|jpeg|gif|webp|ico|wasm|map|json|woff|woff2|ttf|eot))$ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files /$2 =404;
  }

  location / {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    expires -1;
    try_files $uri $uri/ /index.html;
  }
}
