{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGiXT Desktop",
  "version": "0.1.0",
  "identifier": "systems.xt.agixt.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AGiXT",
        "url": "index.html",
        "width": 400,
        "height": 800,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true,
        "shadow": true
      },
      {
        "label": "agent-settings",
        "title": "Agent Settings",
        "url": "agent-settings.html",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "AGiXT Desktop"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agixt"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
